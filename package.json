{
  "name": "cliper-job",
  "productName": "CLIPER JOB",
  "version": "1.7.0",
  "description": "AI Auto Clipper 100% OFFLINE - potong video panjang menjadi klip viral TikTok/Shorts/Reels dengan subtitle karaoke animasi, tanpa API key",
  "main": "main.js",
  "author": "zacrie85",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "prebuild": "bash scripts/ensure-winsharp.sh",
    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@xenova/transformers": "2.17.2",
    "wavefile": "11.0.0"
  },
  "optionalDependencies": {
    "@img/sharp-win32-x64": "0.33.5"
  },
  "overrides": {
    "sharp": "0.33.5"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "io.github.zacrie85.cliperjob",
    "productName": "CLIPER JOB",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "resources/fonts",
        "to": "fonts"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "CLIPER JOB",
      "artifactName": "CLIPER-JOB-Setup-${version}.exe"
    }
  }
}
